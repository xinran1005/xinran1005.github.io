---
import 'plyr/dist/plyr.css';
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import MediaCard from '../components/MediaCard.astro';
import Lightbox from '../components/Lightbox.astro';
import { designSections, type Photo, type ProjectLink } from '../data/portfolio';

interface DesignProject {
  title: string;
  image?: string;
  albumFolder?: string;
  youtubeId?: string;
  src?: string;
  status: string;
  description: string;
  details?: string[];
  links?: ProjectLink[];
  photos?: Photo[];
}

function toPhoto(f: string, folder: string): Photo {
  const url = `${folder}/${f}`;
  return {
    src: url,
    srcOriginal: url.replace('__w800', ''),
  };
}

function resolveProject(project: DesignProject): DesignProject {
  if (project.albumFolder) {
    const dir = path.join(process.cwd(), 'public', 'design', project.albumFolder);
    if (fs.existsSync(dir)) {
      const files = fs
        .readdirSync(dir)
        .filter((f) => f.includes('__w800'))
        .sort();
      if (files.length > 0) {
        return { ...project, photos: files.map((f) => toPhoto(f, project.albumFolder!)) };
      }
    }
  }
  return project;
}
---

<Layout title="Design" description="UI/UX and graphic design works organized by discipline." currentPath="/design/">
    <h1 class="page-title">Design</h1>
    <div class="design-sections">
      {designSections.map((section) => (
        <section class="design-section" aria-label={`${section.title} Design projects`}>
          <div class="section-heading">
            <h2 class="section-kicker">{section.title}</h2>
            <p>{section.description}</p>
          </div>

          <div class="design-list">
            {section.projects.map((project, index) => {
              const p = resolveProject(project);
              return (
                <MediaCard
                  photos={p.photos}
                  youtubeId={p.youtubeId}
                  src={p.src}
                  playerId={`design-${index}`}
                  title={p.title}
                  kicker={p.status}
                  description={p.description}
                  details={p.details}
                  links={p.links}
                />
              );
            })}
          </div>
        </section>
      ))}
    </div>

    <Lightbox/>
</Layout>

<style>

  h2.section-kicker {
    font-size: 1.2rem;
    font-weight: normal;
    margin: 0;
  }

  .design-sections {
    display: grid;
    gap: 3rem
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .design-section {
    display: grid;
    gap: 1.4rem;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(160px, 0.3fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: 1.2rem;
  }

  .section-heading p {
    margin: 0;
    font-family: var(--serif);
    font-size: 2rem;
    line-height: 1.05;
    text-align: end;
  }

  .design-list {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 640px) {
    .section-heading {
      grid-template-columns: 25% auto;
    }
  }
</style>

<script>
  import Plyr from 'plyr';

  document.querySelectorAll('.plyr__video-embed').forEach((player) => {
    new Plyr(player, {
      controls: ['play-large', 'play', 'progress', 'current-time', 'mute', 'volume', 'fullscreen'],
    });
  });
</script>
