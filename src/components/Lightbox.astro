---
export interface Props {
  padding?: boolean;
}
const { padding = false } = Astro.props;
---

<dialog class="lightbox" aria-label="Photo viewer" data-padding={padding}>
  <div class="lightbox-body">
    <div class="polaroid">
      <img src="" alt="" />
      <p class="name"></p>
      <p class="counter"></p>
      <div class="loading-spinner" aria-hidden="true"></div>
    </div>
    <button class="close lightboxbutton" type="button" aria-label="Close photo viewer">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5"/></svg>
      <span>Close</span>
    </button>
    <button class="previous lightboxbutton" type="button" aria-label="Previous photo">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5"/></svg>
      <span>Prev</span>
    </button>
    <button class="next lightboxbutton" type="button" aria-label="Next photo">
      <span>Next</span>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg>
    </button>
  </div>
</dialog>

<style>
  .lightbox {
    width: min(1000px, calc(100% - 2rem));
    border: 0;
    padding: 0;
    background: transparent;
  }

  .lightbox::backdrop {
    background: rgba(21, 19, 15, 0.85);
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-body {
    position: relative;
    width: 100%;
    min-height: 80vh;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lightbox .polaroid {
    position: relative;
    background: transparent;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
  }

  .lightbox .polaroid[data-padding]{
    padding: 1rem 1rem 3rem;
  }

  .lightbox .polaroid.loaded[data-padding] {
    background: #fff;
  }

  .lightbox .polaroid img {
    display: block;
    max-height: 70vh;
    width: auto;
    max-width: 100%;
    margin: 0 auto;
    opacity: 0;
    transition: opacity 250ms ease;
  }

  .lightbox .polaroid.loaded img {
    opacity: 1;
  }

  .lightbox .polaroid:not(.loaded) {
    min-height: 200px;
    min-width: 200px;
  }

  .lightbox .polaroid:not(.loaded) .counter {
    display: none;
  }

  .lightbox .polaroid:not(.loaded) .name {
    color: var(--muted);
  }

  .loading-spinner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .loading-spinner::after {
    content: '';
    width: 32px;
    height: 32px;
    border: 3px solid var(--line);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 600ms linear infinite;
  }

  .polaroid.loaded .loading-spinner {
    display: none;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .lightbox button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    padding: 0.55rem 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .lightbox button:hover {
    color: var(--accent);
  }

  .lightbox button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .lightbox button:disabled:hover {
    color: var(--ink);
  }

  .lightbox .close {
    position: absolute;
    top: 0;
    right: 0;
  }

  .previous {
    position: absolute;
    left: 0;
    top: 50%;
    translate: 0 -50%;
  }

  .next {
    position: absolute;
    right: 0;
    top: 50%;
    translate: 0 -50%;
  }

  .counter {
    position: absolute;
    top: -.1rem;
    left: 50%;
    translate: -50% 0;
    margin: 0rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .lightbox .polaroid:not([data-padding]) .counter {
    top: auto;
    bottom: -2rem;
  }

  .name {
    position: absolute;
    bottom: 0.6rem;
    left: 1rem;
    right: 1rem;
    margin: 0;
    color: var(--ink);
    font-family: var(--handwritten), cursive;
    font-size: 1.5rem;
    line-height: 1;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    text-align: center;
  }

  @media (max-width: 680px) {
    .name {
      font-size: 1rem;
    }

    .lightbox .close {
      top: 0;
      right: 0;
    }

    .lightboxbutton span{
      display: none;
    }
  }
</style>

<script>
  const dialog = document.querySelector('.lightbox');
  const polaroid = dialog?.querySelector('.polaroid');
  const image = dialog?.querySelector('img');
  const counter = dialog?.querySelector('.counter');
  const name = dialog?.querySelector('.name');
  const close = dialog?.querySelector('.close');
  const previous = dialog?.querySelector('.previous');
  const next = dialog?.querySelector('.next');

  let photos = [];
  let current = 0;
  let loading = false;
  let showName = false;
  const defaultPadding = dialog?.dataset.padding !== 'false';

  function setNavDisabled(disabled) {
    if (previous) previous.disabled = disabled;
    if (next) next.disabled = disabled;
  }

  function show(index) {
    if (!dialog || !image || !counter || photos.length === 0) return;
    if (loading) return;
    if (image) image.src = '';
    if (name) name.textContent = '';
    const i = (index + photos.length) % photos.length;
    if (image.src !== photos[i].srcOriginal || !dialog.open) {
      loading = true;
      setNavDisabled(true);
      polaroid?.classList.remove('loaded');
      current = i;
      const src = photos[current].srcOriginal || '';
      image.addEventListener('load', updateInfo, { once: true });
      image.addEventListener('error', updateInfo, { once: true });
      image.src = src;
    }
    if (!dialog.open) {
      const scrollY = window.scrollY;
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
      window.scrollTo(0, scrollY);
    }
  }

  function updateInfo() {
    loading = false;
    setNavDisabled(false);
    polaroid?.classList.add('loaded');    
    const src = photos[current]?.srcOriginal || '';
    if (name) name.textContent = showName ? (src.split('/').pop() || '').replace(/\.\w+$/, '') : '';
    if (counter) counter.textContent = `${current + 1} / ${photos.length}`;
  }

  function closeDialog() {
    dialog?.close();
    document.documentElement.style.overflow = '';
    loading = false;
    setNavDisabled(false);
    if (image) image.src = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22/%3E';
    if (name) name.textContent = '';
  }

  document.addEventListener('open-lightbox', (e) => {
    photos = e.detail.photos;
    showName = !!e.detail.showName;
    
    if (polaroid) {
      polaroid.toggleAttribute('data-padding', defaultPadding);
    }
    show(e.detail.index);
  });

  close?.addEventListener('click', closeDialog);
  previous?.addEventListener('click', () => show(current - 1));
  next?.addEventListener('click', () => show(current + 1));
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) { closeDialog(); }
  });
  dialog?.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    loading = false;
    setNavDisabled(false);
    if (image) image.src = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22/%3E';
    if (name) name.textContent = '';
  });
  document.addEventListener('keydown', (event) => {
    if (!dialog?.open) return;
    if (event.key === 'ArrowLeft') show(current - 1);
    if (event.key === 'ArrowRight') show(current + 1);
  });
</script>
