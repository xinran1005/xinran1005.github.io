---
import type { Photo } from '../data/portfolio';

export interface Props {
  photos: Photo[];
  alt?: string;
}

const { photos, alt } = Astro.props;
---

<div class="photo-carousel" data-carousel>
  <div class="carousel-track">
    {photos.map((photo, index) => (
      <div class="carousel-slide" data-index={index}>
        <img src={photo.src} data-src-original={photo.srcOriginal} alt={alt ? `${alt} ${index + 1}` : ''} loading={index === 0 ? 'eager' : 'lazy'} />
      </div>
    ))}
  </div>

  <button class="carousel-prev" type="button" aria-label="Previous photo">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5"/></svg>
  </button>

  <button class="carousel-next" type="button" aria-label="Next photo">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg>
  </button>

  <div class="carousel-dots">
    {photos.map((_, index) => (
      <button class="carousel-dot" data-index={index} type="button" aria-label={`Photo ${index + 1}`}></button>
    ))}
  </div>

</div>

<style>
  .photo-carousel {
    position: relative;
    overflow: hidden;
    background: transparent;
  }

  .carousel-track {
    display: flex;
    transition: transform 400ms ease;
  }

  .carousel-slide {
    min-width: 100%;
    line-height: 0;
  }

  .carousel-slide img {
    width: 100%;
    display: block;
    aspect-ratio: 16 / 10;
    object-fit: contain;
  }

  .carousel-prev,
  .carousel-next {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: rgba(255, 253, 250, 0.85);
    color: var(--ink);
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 200ms ease;
  }

  .carousel-prev:hover,
  .carousel-next:hover {
    opacity: 1;
    color: var(--accent);
    background: #fff;
  }

  .carousel-prev { left: 0.5rem; }
  .carousel-next { right: 0.5rem; }

  .carousel-dots {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    translate: -50% 0;
    display: flex;
    gap: 0.35rem;
    z-index: 2;
    padding: 0.35rem 0.5rem;
    border-radius: 1rem;
    background: rgba(0,0,0,0.25);
    backdrop-filter: blur(4px);
  }

  .carousel-dot {
    width: 0.45rem;
    height: 0.45rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 253, 250, 0.5);
    cursor: pointer;
    transition: background 200ms ease;
  }

  .carousel-dot[aria-current] {
    background: rgba(255, 253, 250, 0.9);
  }

  .carousel-dot:hover {
    background: rgba(255, 253, 250, 0.75);
  }

</style>

<script>
  document.querySelectorAll('[data-carousel]').forEach((el) => {
    if (el.dataset.init) return;
    el.dataset.init = '';

    const track = el.querySelector('.carousel-track');
    const originalSlides = el.querySelectorAll('.carousel-slide');
    const images = el.querySelectorAll('.carousel-slide img');
    const prevBtn = el.querySelector('.carousel-prev');
    const nextBtn = el.querySelector('.carousel-next');
    const dots = el.querySelectorAll('.carousel-dot');

    if (!track || originalSlides.length === 0) return;
    const total = originalSlides.length;
    let current = 0;

    const firstClone = originalSlides[0].cloneNode(true);
    const lastClone = originalSlides[total - 1].cloneNode(true);
    track.appendChild(firstClone);
    track.insertBefore(lastClone, track.firstChild);
    const allSlides = track.querySelectorAll('.carousel-slide');
    const slideWidth = () => allSlides[0].offsetWidth;

    go(1, true);

    function go(index, instant = false) {
      if (instant) track.style.transition = 'none';
      current = index;
      track.style.transform = `translateX(-${current * 100}%)`;
      if (instant) {
        requestAnimationFrame(() => { requestAnimationFrame(() => { track.style.transition = ''; }); });
      }
      const realIndex = ((current - 1) % total + total) % total;
      dots.forEach((dot, i) => {
        dot.toggleAttribute('aria-current', i === realIndex);
      });
    }

    function handleTransitionEnd() {
      if (current === 0) {
        go(total, true);
      } else if (current > total) {
        go(1, true);
      }
    }
    track.addEventListener('transitionend', handleTransitionEnd);

    images.forEach((img, i) => {
      img.style.cursor = 'zoom-in';
      img.addEventListener('click', () => {
        const photos = [...images].map((el) => ({ srcOriginal: el.dataset.srcOriginal || el.src }));
        document.dispatchEvent(new CustomEvent('open-lightbox', {
          detail: { photos, index: i, showName: false },
        }));
      });
    });

    prevBtn?.addEventListener('click', () => go(current - 1));
    nextBtn?.addEventListener('click', () => go(current + 1));
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const realIndex = parseInt(dot.dataset.index || '0');
        go(realIndex + 1);
      });
    });

    let touchStartX = 0;
    let touchStartY = 0;
    el.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
    }, { passive: true });
    el.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].screenX - touchStartX;
      const dy = e.changedTouches[0].screenY - touchStartY;
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 40) {
        go(current + (dx < 0 ? 1 : -1));
      }
    }, { passive: true });

    let autoTimer = null;
    const AUTO_INTERVAL = 4000;

    function startAutoRotate() {
      stopAutoRotate();
      autoTimer = setInterval(() => go(current + 1), AUTO_INTERVAL);
    }

    function stopAutoRotate() {
      if (autoTimer !== null) {
        clearInterval(autoTimer);
        autoTimer = null;
      }
    }

    function resetAutoTimer() {
      if (autoTimer !== null) startAutoRotate();
    }

    const obs = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          startAutoRotate();
        } else {
          stopAutoRotate();
        }
      });
    }, { threshold: 0.5 });
    obs.observe(el);

    prevBtn?.addEventListener('click', resetAutoTimer);
    nextBtn?.addEventListener('click', resetAutoTimer);
    dots.forEach((dot) => {
      dot.addEventListener('click', resetAutoTimer);
    });
    el.addEventListener('touchend', resetAutoTimer, { passive: true });
  });
</script>
