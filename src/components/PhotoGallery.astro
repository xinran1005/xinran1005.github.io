---
import type { Photo } from '../data/portfolio';

export interface Props {
  album: {
    id: string;
    title: string;
    description: string;
    photos: Photo[];
    showName?: boolean;
  };
}

const { album } = Astro.props;
const sectionId = `album-${album.id}`;
---

<section class="album-section" id={sectionId} data-photo-gallery={album.id} { ...(album.showName && { 'data-show-name': '' }) } aria-labelledby={`${sectionId}-title`}>
  <div class="album-heading">
    <h2 id={`${sectionId}-title`} class="album-title">{album.title}</h2>
    <p class="section-kicker">{album.description}</p>
  </div>

  <div class="photo-grid">
    {album.photos.map((photo, index) => (
      <button class="photo-button" data-src={photo.srcOriginal} data-index={index} aria-label={`${album.title} photo ${index + 1}`}>
        <img src={photo.src} alt="" loading="lazy" />
      </button>
    ))}
  </div>
</section>

<style>
  .album-section {
    scroll-margin-top: 3.5rem;
    margin-bottom: 3rem;
  }

  .album-heading {
    margin-bottom: 2rem;
  }

  .album-title {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 400;
  }

  .album-heading p {
    margin: 0;
    color: var(--muted);
  }

  .photo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 600px) {
    .photo-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .photo-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .photo-button {
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .photo-button img {
    width: 100%;
    border: 1px solid var(--line);
    transition: filter 180ms ease, transform 180ms ease;
  }

  .photo-button:hover img,
  .photo-button:focus-visible img {
    transform: translateY(-2px);
  }

  .photo-button:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }
</style>

<script>
  document.querySelectorAll('[data-photo-gallery]').forEach((section) => {
    if (section.dataset.init) return;
    section.dataset.init = '';

    const photos = [...section.querySelectorAll('.photo-button')].map((btn) => ({
      srcOriginal: btn.dataset.src,
    }));
    const showName = section.hasAttribute('data-show-name');

    section.querySelectorAll('.photo-button').forEach((button, index) => {
      button.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('open-lightbox', {
          detail: { photos, index, showName },
        }));
      });
    });
  });
</script>
