---
import BackToTop from '../components/BackToTop.astro';
import { contactLinks, navItems, site } from '../data/portfolio';
export interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}
import { Font } from "astro:assets";
const {
  title = site.title,
  description = site.description,
  currentPath = Astro.url.pathname,
} = Astro.props;
const pageTitle = title === site.title ? title : `${title} | ${site.name}`;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="sitemap" href="/sitemap-0.xml" />
    <meta name="google-site-verification" content="zBRGfbPBx1wqXZjs6QcP3pynj6-uwkcLjdX6OmsRFSk" />
    <Font cssVariable="--handwritten" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label={`${site.name} home`}>
        <img class="brand-favicon" src="/favicon.svg" alt="" />
        <span>{site.name}</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        {navItems.map((item, i) => (
          <>
            {i > 0 && <span class="nav-sep" aria-hidden="true">/</span>}
            <a
              href={currentPath === item.href ? '#' : item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.title}
            </a>
          </>
        ))}
      </nav>
      <button class="hamburger" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    </header>
    <main id="main-content" class="page-shell">
      <slot />
    </main>
    {currentPath !== '/' && <BackToTop />}
    <footer class="site-footer">
      <nav aria-label="Contact links">
        {contactLinks.map((link) => (
          <a
            href={link.href}
            aria-label={link.ariaLabel}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {link.label === 'LinkedIn' && <span class="contact-icon" data-icon="linkedin"></span>}
            {link.label === 'Instagram' && <span class="contact-icon" data-icon="instagram"></span>}
            {link.label === 'SoundCloud' && <span class="contact-icon" data-icon="soundcloud"></span>}
            {link.label === 'Email' && <span class="contact-icon" data-icon="mail"></span>}
            {link.label}
          </a>
        ))}
        <span>&copy; 2026 {site.name}</span>
      </nav>
    </footer>
    <script is:inline>
      const hamburger = document.querySelector('.hamburger');
      hamburger?.addEventListener('click', () => {
        document.documentElement.classList.toggle('nav-open');
      });
    </script>
  </body>

</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 0;
    z-index: 100;
    padding: 0.5rem 1rem;
    background: var(--accent);
    color: var(--paper);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .skip-link:focus {
    top: 0;
  }

  *, *::before, *::after {
    box-sizing: border-box;
  }

  :root {
    --bg: #f6f3ee;
    --paper: #fffdfa;
    --ink: #15130f;
    --muted: #6f6a61;
    --line: #d9d1c6;
    --accent: #a4492d;
    --shadow: 0 24px 70px rgba(30, 24, 18, 0.08);
    --serif: Georgia, 'Times New Roman', serif;
    --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    position: relative;
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  img {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
  }

  .plyr {
    --plyr-color-main: var(--accent);
    height: 100%;
  }

  button,
  input {
    font: inherit;
  }

  ::selection {
    background: var(--accent);
    color: var(--paper);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: auto 1rem;
    height: 3.5rem;
    padding: 1rem clamp(1rem, 4vw, 3rem);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    backdrop-filter: blur(18px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--serif);
    font-size: 1.2rem;
    text-decoration: none;
  }

  .brand-favicon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
  }

  .site-footer nav {
    justify-content: center;
  }

  .site-nav,
  .site-footer nav {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 2vw, 1.5rem);
    flex-wrap: wrap;
  }

  .site-nav a,
  .site-footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'],
  .site-footer a:hover {
    color: var(--accent);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    overflow: hidden;
  }

  .hamburger span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--muted);
    border-radius: 1px;
    transition: transform 200ms ease;
  }

  .nav-open .hamburger span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-open .hamburger span:nth-child(2) {
    transform: scaleX(0);
  }

  .nav-open .hamburger span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .nav-open .hamburger:hover span {
    background: var(--accent);
  }

  .nav-sep {
    color: var(--line);
    pointer-events: none;
  }

  .site-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3rem;
    gap: 0 2rem;
    flex-wrap: wrap;
    padding: 1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .site-footer span {
    margin: 0;
    font-size: 0.8rem;
  }

  .page-shell {
    width: min(1180px, calc(100% - 2rem));
    min-height: calc(100vh - 6.5rem);
    margin: 0 auto;
  }

  .page-title {
    color: var(--accent);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    padding: 1rem 0;
    font-weight: normal;
    text-transform: uppercase;
  }

  .section-kicker {
    margin: 0 0 0.8rem;
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-title {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.4rem, 8vw, 6.4rem);
    font-weight: 400;
    line-height: 0.95;
  }

  .section-copy {
    max-width: 680px;
    margin: 1.2rem 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.16rem);
  }

  .contact-icon {
    display: inline-block;
    width: 12px;
    height: 12px;
    background-color: var(--muted);
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
    -webkit-mask-size: contain;
    transition: background-color 180ms ease;
  }

  .contact-icon[data-icon="linkedin"] {
    mask-image: url(/linkedin.svg);
    -webkit-mask-image: url(/linkedin.svg);
  }

  .contact-icon[data-icon="instagram"] {
    mask-image: url(/instagram.svg);
    -webkit-mask-image: url(/instagram.svg);
  }

  .contact-icon[data-icon="soundcloud"] {
    mask-image: url(/soundcloud.svg);
    -webkit-mask-image: url(/soundcloud.svg);
  }

  .contact-icon[data-icon="mail"] {
    mask-image: url(/mail.svg);
    -webkit-mask-image: url(/mail.svg);
  }

  .site-footer a:hover .contact-icon {
    background-color: var(--accent);
  }

  @media (max-width: 640px) {
    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      padding: 0.5rem clamp(1rem, 4vw, 3rem) 1rem;
      background: color-mix(in srgb, var(--bg) 88%, transparent);
      border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
      backdrop-filter: blur(18px);
      gap: 0;
    }

    .site-nav a {
      display: block;
      padding: 0.5rem 0;
      font-size: 0.9rem;
    }

    .nav-sep {
      display: none;
    }

    .nav-open .site-nav {
      display: flex;
    }

    .hamburger {
      display: flex;
    }

    .site-footer {
      height: auto;
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
